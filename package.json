{
  "name": "licensehunter-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "LicenseHunter - Turn IP Infringement Into Instant Licensing",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test -vvv",
    "contracts:deploy": "cd contracts && forge script script/Deploy.s.sol --rpc-url $RPC_URL --broadcast"
  },
  "keywords": [
    "web3",
    "licensing",
    "ip",
    "blockchain",
    "evm",
    "smart-contracts",
    "foundry",
    "nextjs"
  ],
  "author": "LicenseHunter Team",
  "license": "MIT"
}
